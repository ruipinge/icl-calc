{
  "name": "icl-calc",
  "version": "1.8.3",
  "author": "Rui Pinge",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:ruipinge/icl-calc.git"
  },
  "homepage": "http://ruipinge.github.io/icl-calc",
  "bugs": {
    "url": "https://github.com/ruipinge/icl-calc/issues"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "bootstrap": "^4.6.0",
    "date-fns": "^2.19.0",
    "formik": "^2.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "yup": "^0.32.9"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --coverage",
    "clean": "rm -rf ./node_modules ./coverage ./npm-debug.log ./build",
    "format:check": "prettier --check './src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "format": "prettier --write './src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "lint": "eslint src/",
    "semantic-release": "semantic-release"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "none",
    "singleQuote": true,
    "printWidth": 80
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "assets": []
        }
      ],
      "@semantic-release/npm"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.12.0",
    "jsdom": "^24.1.3",
    "prettier": "3.9.6",
    "sass": "^1.32.8",
    "semantic-release": "^17.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^4.5.14",
    "vitest": "^1.6.1"
  }
}
