{
  "name": "icl-calc",
  "version": "1.7.0",
  "author": "Rui Pinge",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:ruipinge/icl-calc.git"
  },
  "homepage": "http://ruipinge.github.io/icl-calc",
  "bugs": {
    "url": "https://github.com/ruipinge/icl-calc/issues"
  },
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.17",
    "@semantic-release/git": "^9.0.0",
    "@sentry/react": "^10.73.0",
    "@types/node": "^22",
    "@types/react-router-dom": "^5.1.7",
    "bootstrap": "^4.6.0",
    "date-fns": "^2.19.0",
    "eslint-plugin-prettier": "^3.3.1",
    "formik": "^2.2.6",
    "prettier": "2.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^5.2.0",
    "sass": "^1.32.8",
    "semantic-release": "^17.4.2",
    "yup": "^0.32.9"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --coverage",
    "clean": "rm -rf ./node_modules ./coverage ./npm-debug.log ./build",
    "format": "prettier --write './src/**.{js,jsx,ts,tsx}'",
    "lint": "eslint src/",
    "semantic-release": "semantic-release"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "sort-imports": [
        "error",
        {
          "ignoreCase": false,
          "ignoreDeclarationSort": false,
          "ignoreMemberSort": false,
          "memberSyntaxSortOrder": [
            "none",
            "all",
            "multiple",
            "single"
          ],
          "allowSeparatedGroups": false
        }
      ]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "none",
    "singleQuote": true,
    "printWidth": 80
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "assets": []
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/git"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^4.5.0",
    "@typescript-eslint/parser": "^4.5.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.11.0",
    "eslint-config-react-app": "^6.0.0",
    "eslint-plugin-flowtype": "^5.2.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^24.1.0",
    "eslint-plugin-jsx-a11y": "^6.3.1",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-testing-library": "^3.9.2",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vitest": "^1.6.1"
  }
}
