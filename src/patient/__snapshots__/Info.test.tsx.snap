// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renders without crashing 1`] = `
<DocumentFragment>
  <h4>
    Information
  </h4>
  <div
    class="form-row"
  >
    <div
      class="form-group col-md-4"
    >
      <label
        for="fieldName"
      >
        Name
      </label>
      <input
        autocomplete="off"
        class="form-control"
        id="fieldName"
        name="patient.name"
        placeholder="enter patient name"
        value="Pedro Duarte"
      />
    </div>
    <div
      class="form-group col-md-2 offset-md-1"
    >
      <label
        for="fieldDateOfBirth"
      >
        Date of Birth
      </label>
      <input
        autocomplete="off"
        class="form-control"
        id="fieldDateOfBirth"
        maxlength="10"
        name="patient.dateOfBirth"
        placeholder="yyyy-mm-dd"
        value="2000-07-01"
      />
    </div>
    <div
      class="form-group col-md-2"
    >
      <label
        for="fieldAge"
      >
        Age
      </label>
      <div
        class="input-group"
      >
        <input
          class="form-control text-right"
          disabled=""
          id="fieldAge"
          name="age"
          value="20"
        />
        <div
          class="input-group-append"
        >
          <span
            class="input-group-text"
            title="years"
          >
            years
          </span>
        </div>
      </div>
    </div>
    <div
      class="form-group col-md-2 offset-md-1"
    >
      <label
        for="fieldEye"
      >
        Eye
      </label>
      <select
        class="form-control"
        id="fieldEye"
        name="patient.eye"
      >
        <option
          value=""
        >
          Select...
        </option>
        <option
          value="left"
        >
          Left
        </option>
        <option
          value="right"
        >
          Right
        </option>
      </select>
    </div>
  </div>
</DocumentFragment>
`;
